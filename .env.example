# Upstream provider (any OpenAI-compatible API). The gateway holds this key;
# tenants never see it.
UPSTREAM_BASE_URL=https://api.openai.com/v1
UPSTREAM_API_KEY=sk-...
UPSTREAM_TRANSPORT=fast          # fast | httpx
UPSTREAM_READ_TIMEOUT=120

# Governance store
REDIS_URL=redis://localhost:6379/0
FAIL_OPEN=true                   # keep serving (local RPM guard) if Redis is down
REDIS_SOCKET_TIMEOUT=0.25
REDIS_BREAKER_THRESHOLD=5
REDIS_BREAKER_RECOVERY_SECONDS=5

# Token governance
BUDGET_PERIOD=day                # day | month (UTC)
DEFAULT_MAX_TOKENS=1024          # reserved/enforced when a request omits max_tokens
ENFORCE_MAX_TOKENS=true
PROMPT_ESTIMATE_MARGIN=1.2
INJECT_STREAM_USAGE=true

# Tenants & control plane
TENANTS_FILE=config/tenants.example.json
ADMIN_API_KEY=change-me
TENANT_CACHE_TTL=10

LOG_LEVEL=INFO
